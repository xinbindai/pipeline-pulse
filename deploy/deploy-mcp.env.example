# Config for deploy/deploy-mcp.sh.
#
#   cp deploy/deploy-mcp.env.example deploy/deploy-mcp.env   # then edit
#
# The script auto-loads deploy/deploy-mcp.env. Values here are defaults; anything
# already set in your shell environment takes precedence (so you can override
# inline, e.g. `TAG=v2 ./deploy/deploy-mcp.sh`). deploy/*.env is gitignored.

# --- Required (or falls back to your active gcloud project) ---
# PROJECT_ID=my-gcp-project

# --- Cloud Run / Artifact Registry ---
REGION=us-central1
SERVICE=bx-workflow-mcp
AR_REPO=mcp
# TAG=latest                 # default: current git short SHA, else "latest"
ALLOW_UNAUTH=true

# --- Runtime service account (optional; defaults to the compute SA) ---
# SERVICE_ACCOUNT=my-sa@my-gcp-project.iam.gserviceaccount.com

# --- GCS-backed tool data ---
# servicenow / cgp_log_search / nginx_log_search read from this bucket.
# Default: <project>-mcp-data (created on deploy). Upload the data first:
#   GCS_BUCKET=<bucket> python mcp-server/gcs_upload.py
# GCS_BUCKET=my-mcp-data
# Object path overrides (defaults shown):
# SERVICENOW_OBJECT=servicenow/incidents.csv
# CGP_LOG_OBJECT=log/CGP.log
# NGINX_LOG_OBJECT=log/nginx.log
