# Config for deploy/deploy-chroma.sh.
#
#   cp deploy/deploy-chroma.env.example deploy/deploy-chroma.env   # then edit
#
# The script auto-loads deploy/deploy-chroma.env. Values here are defaults;
# anything already set in your shell environment takes precedence (override
# inline, e.g. `TAG=v2 ./deploy/deploy-chroma.sh`). deploy/*.env is gitignored.

# --- Required (or falls back to your active gcloud project) ---
# PROJECT_ID=my-gcp-project

# --- Cloud Run / Artifact Registry ---
REGION=us-central1
SERVICE=chroma-server
AR_REPO=mcp
# TAG=latest                 # default: current git short SHA, else "latest"
ALLOW_UNAUTH=true

# --- Persistence (Cloud Storage bucket mounted at /data) ---
# Defaults to <project>-chroma-data; created if missing.
# BUCKET=my-chroma-bucket

# --- Optional token auth (clients send: Authorization: Bearer <token>) ---
# AUTH_TOKEN=change-me
